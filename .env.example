APP_NAME="Young Go LMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Optional absolute QPDF executable path. Leave unset to use PATH.
# MEDIA_QPDF_BINARY=
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=array
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Email provider: Amazon SES (O-021). Keep MAIL_MAILER=array/log locally; set MAIL_MAILER=ses plus the keys below in production.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

DESIGN_TOKEN_PREVIEW=false

# Required before registration can accept the current legal documents.
TERMS_VERSION=
PRIVACY_VERSION=

# Staff 2FA is mandatory for super_admin, admin and finance. Disable only for local development.
TWO_FACTOR_ENFORCED=true

# Optional support contact shown on error pages.
SUPPORT_EMAIL=

# Payments (T-P8-02). Paymob credentials are not available yet (B-07); leave empty. Never commit real values.
PAYMENTS_GATEWAY=auto
PAYMENTS_LIVE_ENABLED=false
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_API_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_CARD=
PAYMOB_INTEGRATION_WALLET=

# Error tracking: Sentry SaaS (O-029, ED-021). Inert while SENTRY_DSN is empty.
ERROR_REPORTER=sentry
SENTRY_DSN=
SENTRY_ENVIRONMENT=

# AI provider: OpenAI (O-014). Inert while the key is empty; never used for minors until legal approves.
AI_PROVIDER=unconfigured
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Settlements (O-012): four-eyes approval and minimum payout in minor units (500 EGP / 100 SAR).
SETTLEMENT_FOUR_EYES=true
SETTLEMENT_MIN_PAYOUT_EGP_MINOR=50000
SETTLEMENT_MIN_PAYOUT_SAR_MINOR=10000
