<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Arch"><directory>tests/Arch</directory></testsuite>
        <testsuite name="Browser"><directory>tests/Browser</directory></testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_LOCALE" value="en" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="TWO_FACTOR_ENFORCED" value="false"/>
        <env name="GUARDIAN_VERIFICATION_REQUIRED_FOR_AI" value="false"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="AI_INGEST_ON_UPLOAD" value="false"/>
        <!-- 2026-11-18 O-012: production defaults are four-eyes ON and 500 EGP / 100 SAR minimum payout; legacy settlement tests use one finance user and tiny amounts, so they run with both relaxed. New tests set config() explicitly. -->
        <env name="SETTLEMENT_FOUR_EYES" value="false"/>
        <env name="SETTLEMENT_MIN_PAYOUT_EGP_MINOR" value="0"/>
        <env name="SETTLEMENT_MIN_PAYOUT_SAR_MINOR" value="0"/>
        <env name="SESSION_LIMITS_ENABLED" value="false"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
