{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "young-go/lms",
    "type": "project",
    "description": "Young Go custom learning platform",
    "keywords": [
        "laravel",
        "framework"
    ],
    "require": {
        "php": "^8.4",
        "laravel/framework": "^13.42",
        "laravel/tinker": "^3.0",
        "filament/filament": "^5.11",
        "livewire/livewire": "^4.4.8",
        "laravel/horizon": "^5.51",
        "laravel/pulse": "^1.10",
        "laravel/sanctum": "^4.4",
        "laravel/fortify": "^1.42",
        "laravel/pennant": "^1.27",
        "spatie/laravel-permission": "^8.5",
        "spatie/laravel-activitylog": "^5.1",
        "spatie/laravel-translatable": "^6.15",
        "spatie/laravel-medialibrary": "^11.23",
        "brick/money": "^0.15",
        "spatie/laravel-pdf": "^2.14",
        "spatie/browsershot": "^5.5",
        "spatie/laravel-sitemap": "^8.2",
        "spatie/laravel-settings": "^3.10",
        "propaganistas/laravel-phone": "^6.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.15",
        "laravel/pint": "^1.32",
        "laravel/telescope": "^5.29",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-arch": "^5.0",
        "pestphp/pest-plugin-browser": "^5.2",
        "pestphp/pest-plugin-laravel": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@php vendor/bin/pest --exclude-group=browser"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "qa": [
            "@php vendor/bin/pint --test",
            "@php vendor/bin/phpstan analyse --no-progress",
            "@test"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
